PORT=3000
# Change these before going live — never commit real secrets
ADMIN_PASSWORD=choose-a-long-unique-password
SESSION_SECRET=change-this-to-a-long-random-string

# Comma-separated browser origins allowed to call this API (GitHub Pages + local)
CORS_ORIGINS=https://judysvb.com,https://www.judysvb.com,https://n0cct1s.github.io,http://127.0.0.1:3000,http://localhost:3000

# Set COOKIE_SAMESITE=none only if admin is opened from a different domain than the API
# COOKIE_SAMESITE=none

# SMTP settings for sending campaign emails (optional until ready to send)
# Example for Outlook/Hotmail:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=judyssichuan@hotmail.com
# SMTP_PASS=your-app-password
# MAIL_FROM="Judy's Sichuan Cuisine <judyssichuan@hotmail.com>"

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Judy's Sichuan Cuisine <judyssichuan@hotmail.com>

# Optional: live Google rating via Places API (otherwise server scrapes Maps with cache)
# GOOGLE_PLACES_API_KEY=
